# Stromboli configuration — copy to `.env` and fill in real values.
# Variables without a default are REQUIRED; the runtime fails fast on startup
# naming any that are missing. `.env` is gitignored — never commit real secrets.

# --- Intake: Notion is the front-end for adding tasks (PRD §6.1) ----------- #
# Notion integration token (internal integration secret).
NOTION_TOKEN=
# The Notion database the Intake source reads "Ready" tasks from.
NOTION_TASK_DB_ID=

# --- GitHub (PR / Commit node, PRD §6.7) ----------------------------------- #
GITHUB_TOKEN=

# --- Coder surface: Claude Agent SDK, Platform API key (PRD §4) ------------ #
# Predictable per-token cost, no mid-run cutoff. The coding node's agent loop.
ANTHROPIC_API_KEY=
# Optional: the coder model (defaults to claude-opus-4-8).
# CODER_MODEL=claude-opus-4-8

# --- Reasoning + verifier surface: LiteLLM gateway (PRD §4) ---------------- #
# OpenAI-compatible gateway the spec/router/memory and verifier calls route
# through; it maps model names to providers (so the non-Claude verifier needs no
# separate provider key here).
LITELLM_BASE_URL=
LITELLM_API_KEY=op://Dev-Secrets/litellm-strombolli-key/credential
# Optional: cheap reasoning model for spec/router/memory (Haiku-class).
# REASONING_MODEL=claude-haiku-4-5-20251001
# Optional: the non-Claude verifier model (PRD §11.1 — pinned to Gemini 2.5 Pro).
# VERIFIER_MODEL=gemini/gemini-2.5-pro

# --- Observability: Langfuse (PRD §8) -------------------------------------- #
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Filesystem ------------------------------------------------------------ #
# Absolute path under which per-task git worktrees + sandbox state live.
WORKSPACE_ROOT=
# Optional: where ChromaDB persists its three memory collections.
# CHROMA_PERSIST_DIR=.stromboli/chroma
# Optional: the LangGraph checkpointer SQLite file (dev; Postgres deferred).
# CHECKPOINT_DB_PATH=.stromboli/checkpoints.db

# --- Recursion + cost budgets (PRD §5) ------------------------------------- #
# MAX_INNER_TURNS=25          # Agent SDK agent-loop turns per coding attempt.
# MAX_OUTER_REVISIONS=3       # verifier revise edges before escalate.
# MAX_TOKENS_PER_TASK=2000000 # hard cost ceiling across both model surfaces.

# --- Telegram alerts (optional) -------------------------------------------- #
# Both must be set to enable push notifications. These are 1Password references;
# resolve at deploy time with `op inject -i .env.example -o .env` or `op run`.
TELEGRAM_BOT_TOKEN=op://Dev-Secrets/telegram-sys-ops-alert/credential
TELEGRAM_CHAT_ID=op://Dev-Secrets/telegram-sys-ops-alert/username
