# Stromboli configuration — copy to `.env` and fill in real values.
# Every variable below is REQUIRED; the worker fails fast on startup naming any
# that is missing. `.env` is gitignored — never commit real secrets.

# Notion integration token (internal integration secret).
NOTION_TOKEN=

# GitHub token used to clone repos, push branches, and open PRs.
GITHUB_TOKEN=

# Langfuse observability credentials and host.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Public URL of the Cloudflare Tunnel that fronts the dispatch endpoint.
TUNNEL_PUBLIC_URL=

# Absolute path under which per-task git worktrees are created.
WORKSPACE_ROOT=

# Anthropic API key used by the Claude Code (Ralph) loop.
ANTHROPIC_API_KEY=

# Shared secret required in the dispatch request header.
DISPATCH_SHARED_SECRET=
